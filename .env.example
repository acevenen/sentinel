# Copy to .env for local development. Never commit .env.
ANTHROPIC_API_KEY=

# Optional scan defaults. Explicit CLI flags still win.
SENTINEL_FORMAT=terminal
SENTINEL_SEVERITY=low
SENTINEL_CONCURRENCY=4
SENTINEL_MODEL=claude-sonnet-4-5

# Expansion data stays outside Git by default.
SENTINEL_ENGAGEMENT_DIR=.sentinel-data/engagements
SENTINEL_AUDIT_LOG=.sentinel-data/audit.jsonl
SENTINEL_STATE_DIR=.sentinel-data/state
SENTINEL_KILL_SWITCH=
SENTINEL_KNOWLEDGE_DIR=knowledge-data

# Engagement identity/session secrets should use engagement-specific variables,
# for example SENTINEL_TEST_ALICE_TOKEN. Manifests contain only variable names.
