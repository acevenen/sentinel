{
  "dataset": "sentinel-spotter-fingerprints",
  "status": "factual-compilation",
  "notice": "Vendor OUI prefixes are public IEEE MA-L registry assignments. Service and banner strings are vendor-documented conventions. This corpus identifies device families, never individuals.",
  "source": "https://standards-oui.ieee.org/ (IEEE MA-L public registry); vendor product documentation",
  "license": "factual compilation",
  "devices": [
    {
      "id": "hikvision-ip-camera",
      "vendor": "Hikvision",
      "family": "IP camera",
      "category": "camera",
      "rules": [
        { "kind": "mac-oui", "match": "prefix", "value": "44:19:b6", "bits": 6.0, "class": "l2" },
        { "kind": "mac-oui", "match": "prefix", "value": "4c:bd:8f", "bits": 6.0, "class": "l2" },
        { "kind": "mac-oui", "match": "prefix", "value": "c0:56:e3", "bits": 6.0, "class": "l2" },
        { "kind": "http-server", "match": "contains", "value": "hikvision", "bits": 5.5, "class": "http" },
        { "kind": "http-realm", "match": "contains", "value": "dvrnvrdvs", "bits": 5.0, "class": "http" },
        { "kind": "upnp-model", "match": "contains", "value": "hikvision", "bits": 5.0, "class": "upnp" },
        { "kind": "label-model", "match": "prefix", "value": "ds-", "bits": 5.5, "class": "physical" },
        { "kind": "logo", "match": "exact", "value": "hikvision", "bits": 5.0, "class": "physical" }
      ]
    },
