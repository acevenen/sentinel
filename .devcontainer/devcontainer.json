{
  "name": "Sentinel Kali",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "..",
    "args": {
      "USERNAME": "sentinel",
      "USER_UID": "1000",
      "USER_GID": "1000"
    }
  },
  "remoteUser": "sentinel",
  "runArgs": [
    "--cap-add=NET_RAW",
    "--cap-add=NET_ADMIN"
  ],
  "containerEnv": {
    "CGO_ENABLED": "1"
  },
  "postCreateCommand": "make bootstrap",
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go"
      ]
    }
  }
}
